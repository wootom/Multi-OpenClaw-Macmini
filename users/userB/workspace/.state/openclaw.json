{
  "meta": {
    "lastTouchedVersion": "2026.2.15"
  },
  "agents": {
    "defaults": {
      "workspace": "/workspace",
      "skipBootstrap": false,
      "maxConcurrent": 4,
      "subagents": {
        "maxConcurrent": 8
      }
    },
    "list": [
      {
        "id": "main",
        "model": "openai/gpt-4o"
      }
    ]
  },
  "messages": {
    "ackReactionScope": "group-mentions"
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto"
  },
  "channels": {
    "telegram": {
      "dmPolicy": "pairing",
      "botToken": "",
      "groupPolicy": "allowlist",
      "streamMode": "partial"
    }
  },
  "gateway": {
    "port": 3100,
    "mode": "local",
    "bind": "lan",
    "controlUi": {
      "dangerouslyDisableDeviceAuth": true
    }
  },
  "plugins": {
    "entries": {
      "telegram": {
        "enabled": true
      },
      "k-dexter-bridge": {
        "enabled": true
      }
    }
  }
}
